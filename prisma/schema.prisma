datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// ----------------------------------------------------
// 1. MASTER SITES & ORGANIZATIONS
// ----------------------------------------------------

model ParentSite {
  id          String       @id @default(uuid())
  siteCode    String       @unique // e.g. "00940"
  siteName    String       // e.g. "โรงพยาบาลเสนา"
  siteType    String?      @default("Parent Site")
  siteStatus  String?      @default("Active")
  lnPattern   String?
  address     String?
  subdistrict String?
  district    String?
  province    String?
  zipcode     String?
  hospitalFile String?
  isoFile     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  clientSites ClientSite[]
  users       User[]
  orders      Order[]
  wards       Ward[]
}

model ClientSite {
  id             String       @id @default(uuid())
  siteCode       String       @unique // e.g. "00940-01"
  siteName       String       // e.g. "โรงพยาบาลส่งเสริมสุขภาพตำบลทุ่งแสลงหลวง"
  siteType       String?      @default("Client Site")
  siteStatus     String?      @default("Active")
  lnPattern      String?
  parentSiteId   String
  parentSite     ParentSite   @relation(fields: [parentSiteId], references: [id])
  address        String?
  subdistrict    String?
  district       String?
  province       String?
  zipcode        String?
  hospitalFile   String?
  isoFile        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  users          User[]
  orders         Order[]
  shipments      Shipment[]

  @@index([parentSiteId])
  @@index([siteStatus])
}

model Ward {
  id           String       @id @default(uuid())
  wardCode     String       // e.g. "OPD", "IPD1"
  wardName     String       // e.g. "ผู้ป่วยนอก (OPD)"
  wardStatus   String?      @default("Active")
  hospitalFile String?
  selectedSites Json?       // รายการ client site codes เช่น ["00940-01", "00940-02"] หรือ ["ALL"]
  parentSiteId String
  parentSite   ParentSite   @relation(fields: [parentSiteId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  orders       Order[]

  @@index([parentSiteId])
}

model Department {
  id             String       @id @default(uuid())
  departmentCode String       @unique // e.g. "HEM", "CHM", "IMM"
  departmentName String       // e.g. "DEPT: HEMATOLOGY", "DEPT: CHEMISTRY"
  deptStatus     String?      @default("Active")
  hospitalFile   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  testResults    TestResult[]
}

model SampleCondition {
  id            String       @id @default(uuid())
  conditionCode String       @unique // e.g. "HEMOLYSIS", "CLOT", "VOL_INSUF"
  conditionName String       // e.g. "เม็ดเลือดแดงแตก (Hemolysis)"
  sampleStatus  String?      @default("Active")
  isDefault     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  samples       Sample[]
}

model Title {
  id          String   @id @default(uuid())
  titleCode   String   @unique
  titleNameTh String
  titleNameEn String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Ethnicity {
  id              String   @id @default(uuid())
  ethnicityCode   String   @unique
  ethnicityNameTh String
  ethnicityNameEn String?
  status          String   @default("Active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model TestPanel {
  id           String   @id @default(uuid())
  panelCode    String   @unique
  panelName    String
  specimenType String?
  department   String?
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ValueList {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LabTest {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  selectedSites Json?    // Array of site codes or ["ALL"]
  testItems     Json?    // Array of TestSubItem objects
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TestProfile {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  tests         Json?    // Array of test codes
  selectedSites Json?    // Array of site codes or ["ALL"]
  status        String   @default("Active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Analyzer {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "COBAS-6000", "SYSMEX-XN"
  name        String   // e.g. "Roche Cobas 6000"
  department  String?  // e.g. "Clinical Chemistry", "Hematology"
  protocol    String?  // ASTM 1394, HL7 v2.5, TCP/IP
  ipAddress   String?  // e.g. "192.168.10.51"
  port        String?  // e.g. "5000"
  status      String   @default("Active")
  orderCodes  Json?    // Array of AnalyzerOrderCodeItem (orderCode, orderName, resultCodes: [ { resultCode, resultName, unit } ])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ----------------------------------------------------
// 2. USER & ACCESS CONTROL
// ----------------------------------------------------

enum UserRole {
  SYSTEM_ADMINISTRATOR
  LAB_ADMINISTRATOR
  MEDICAL_TECHNOLOGIST
  CLIENT_SITE_USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String       @id @default(uuid())
  username     String       @unique
  passwordHash String
  email        String?
  firstName    String
  lastName     String
  telNo        String?
  position     String?
  organization String?
  userRole     UserRole     @default(SYSTEM_ADMINISTRATOR)
  userStatus   UserStatus   @default(ACTIVE)
  licenseNo    String?      // e.g. "19935" (เลขที่ใบอนุญาต ว.ท.)
  signatureUrl String?      // Path / URL ของรูปลายเซ็นสำหรับแนบในรายงาน
  province     String?      // จังหวัด
  healthRegion String?      // เขตสุขภาพ เช่น "เขต 4"
  
  parentSiteId String?
  parentSite   ParentSite?  @relation(fields: [parentSiteId], references: [id])
  clientSiteId String?
  clientSite   ClientSite?  @relation(fields: [clientSiteId], references: [id])

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  receivedSamples Sample[]  @relation("ReceivedBy")
  rejectedSamples Sample[]  @relation("RejectedBy")
  approvedResults TestResult[] @relation("ApprovedBy")
  auditLogs       AuditLog[]

  @@index([userRole, userStatus])
  @@index([parentSiteId])
  @@index([clientSiteId])
}

// ----------------------------------------------------
// 3. SHIPMENT & LOGISTICS
// ----------------------------------------------------

enum ShipmentStatus {
  PREPARING
  IN_TRANSIT
  RECEIVED
}

model Shipment {
  id             String         @id @default(uuid())
  shipmentNumber String         @unique // e.g. "SHP-202610-001"
  clientSiteId   String
  clientSite     ClientSite     @relation(fields: [clientSiteId], references: [id])
  status         ShipmentStatus @default(PREPARING)
  shipmentDate   DateTime?
  receivedDate   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  orders         Order[]

  @@index([clientSiteId, status])
  @@index([status, createdAt(sort: Desc)])
}

// ----------------------------------------------------
// 4. ORDERS & SPECIMENS (SAMPLES)
// ----------------------------------------------------

enum OrderStatus {
  REGISTERED
  SHIPPED
  RECEIVED
  IN_PROCESS
  COMPLETED
  CANCELLED
}

model Order {
  id             String       @id @default(uuid())
  hn             String       // Hospital Number e.g. "68/01254"
  idCard         String?      // เลขบัตรประชาชน
  passportNo     String?      // หมายเลขหนังสือเดินทาง
  patientName    String       // ชื่อ-สกุลผู้ป่วย e.g. "นายธิติธาดา พัฒลักษณ์"
  
  title          String?      // คำนำหน้าชื่อ e.g. "นาย", "นาง", "นางสาว"
  firstName      String?      // ชื่อจริง
  lastName       String?      // นามสกุล
  gender         String?      // เพศ e.g. "ชาย", "หญิง"
  dob            String?      // วันเกิด e.g. "12/05/2530" หรือ "1987-05-12"
  age            String?      // คำนวณอายุ e.g. "39 YEAR 4 MONTH 24 DAY"
  nationality    String?      // สัญชาติ e.g. "THAI"
  ethnicity      String?      // เชื้อชาติ e.g. "ไทย"
  address        String?      // ที่อยู่
  subdistrict    String?      // ตำบล
  district       String?      // อำเภอ
  province       String?      // จังหวัด
  zipcode        String?      // รหัสไปรษณีย์
  telephone      String?      // เบอร์โทรศัพท์
  patientType    String?      // ประเภทผู้ป่วย e.g. "IPD", "OPD"
  entitlement    String?      // สิทธิการรักษา e.g. "หลักประกันสุขภาพแห่งชาติ (UC)"
  collectedDate  String?      // วันเก็บสิ่งส่งตรวจ
  urgentStatus   String?      @default("NORMAL") // "NORMAL", "URGENT", "STAT"
  testPanel      String?      // รหัส/ชื่อ Test Panel
  testProfile    String?      // รหัส/ชื่อ Test Profile
  testItem       String?      // รหัส/ชื่อ Test Item
  orderItems     Json?        // รายการตรวจทั้งหมด [ { no, testCode, testName, specimenType, department, status } ]

  parentSiteId   String
  parentSite     ParentSite   @relation(fields: [parentSiteId], references: [id])
  clientSiteId   String
  clientSite     ClientSite   @relation(fields: [clientSiteId], references: [id])
  wardId         String?
  ward           Ward?        @relation(fields: [wardId], references: [id])
  shipmentId     String?
  shipment       Shipment?    @relation(fields: [shipmentId], references: [id])

  status         OrderStatus  @default(REGISTERED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  samples        Sample[]

  @@index([hn])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([clientSiteId, status])
  @@index([parentSiteId])
  @@index([status, createdAt(sort: Desc)])
}

enum SpecimenStatus {
  REGISTERED
  RECEIVED
  REJECTED
  IN_PROCESS
  VERIFIED
  APPROVED
}

model Sample {
  id                String           @id @default(uuid())
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  labNumber         String           @unique // e.g. "691006002"
  specimenType      String           // e.g. "Heparinized Blood", "EDTA", "Serum"
  barcode           String?
  profileTestName   String?          // e.g. "Complete Blood Count (CBC)"
  urgentStatus      String?          @default("NORMAL")
  status            SpecimenStatus   @default(REGISTERED)

  // ข้อมูลการตรวจรับ / ปฏิเสธ (Sample Receiving)
  sampleConditionId String?
  sampleCondition   SampleCondition? @relation(fields: [sampleConditionId], references: [id])
  conditionOther    String?
  collectedAt       DateTime?
  receivedAt        DateTime?
  receivedById      String?
  receivedBy        User?            @relation("ReceivedBy", fields: [receivedById], references: [id])
  
  rejectedAt        DateTime?
  rejectedById      String?
  rejectedBy        User?            @relation("RejectedBy", fields: [rejectedById], references: [id])
  rejectionReason   String?

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  testResults       TestResult[]

  @@index([orderId])
  @@index([status])
  @@index([barcode])
  @@index([createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([sampleConditionId])
}

// ----------------------------------------------------
// 5. TEST RESULTS & WORKSTATION
// ----------------------------------------------------

enum ResultFlag {
  NORMAL   // N
  HIGH     // H
  LOW      // L
  ABNORMAL // A
}

model TestResult {
  id             String       @id @default(uuid())
  sampleId       String
  sample         Sample       @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  departmentId   String
  department     Department   @relation(fields: [departmentId], references: [id])

  testPanel      String       // e.g. "CBC", "Electrolyte"
  testName       String       // e.g. "WBC Count"
  testResult     String?      // e.g. "4.52"
  flag           ResultFlag?  @default(NORMAL)
  lastResult     String?      // e.g. "4.16" (ดึงจากประวัติเดิมอัตโนมัติ)
  unit           String?      // e.g. "10^3 cell/ul"
  referenceRange String?      // e.g. "4.00 - 10.00"
  repeatResult   String?      // e.g. "4.48"
  status         String?      @default("NORMAL") // Result status เช่น "NORMAL", "CRITICAL", "PENDING"
  instrumentName String?      // ชื่อเครื่องตรวจวิเคราะห์ (Analyzer)

  // ตรวจสอบและอนุมัติ (Verify & Approve)
  isApproved     Boolean      @default(false)
  approvedAt     DateTime?
  approvedById   String?
  approvedBy     User?        @relation("ApprovedBy", fields: [approvedById], references: [id])

  // Soft Delete / Void ตามมาตรฐาน ISO 15189
  isVoided       Boolean      @default(false)
  voidReason     String?
  voidedAt       DateTime?

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([sampleId])
  @@index([sampleId, isVoided])
  @@index([testName, isVoided, createdAt(sort: Desc)])
  @@index([departmentId])
  @@index([isApproved, approvedAt(sort: Desc)])
}

// ----------------------------------------------------
// 6. AUDIT TRAIL LOGGING
// ----------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g. "LOGIN", "RECEIVE_SAMPLE", "REJECT_SAMPLE", "APPROVE_RESULT", "VOID_RESULT"
  entityType String   // e.g. "Order", "Sample", "TestResult"
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
}
