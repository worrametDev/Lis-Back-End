# ========================================================
# Healthdi Lab LIS — Backend Environment Variables Template
# ========================================================

# Server Configuration
PORT=3001
NODE_ENV=production

# --------------------------------------------------------
# 1. Database Connection (Supabase PostgreSQL / Local)
# --------------------------------------------------------
# For Supabase Production (Port 6543 via Pooler with ?pgbouncer=true):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# For Direct Connection (Prisma Migrate / Schema Push via Port 5432):
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# For Local PostgreSQL Development:
# DATABASE_URL="postgresql://postgres:123456@localhost:5432/healthdi_lab?schema=public"
# DIRECT_URL="postgresql://postgres:123456@localhost:5432/healthdi_lab?schema=public"

# --------------------------------------------------------
# 2. Authentication & Security (JWT)
# --------------------------------------------------------
# Generate a unique secret with at least 32 characters for each environment.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_EXPIRES_IN="15m"

# --------------------------------------------------------
# 3. CORS & Allowed Origins
# --------------------------------------------------------
# Vercel Frontend URL (or comma-separated list of origins)
CORS_ORIGIN="https://your-production-frontend.example.com"

# --------------------------------------------------------
# 4. Supabase Storage (for Cloud File Uploads on Vercel)
# --------------------------------------------------------
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_BUCKET="healthdi-uploads"

# --------------------------------------------------------
# 5. LIS Analyzer Gateway Settings
# --------------------------------------------------------
ANALYZER_TCP_PORT=5000

# --------------------------------------------------------
# 6. Installation Site / Hospital Configuration
# --------------------------------------------------------
HOSPITAL_NAME="โรงพยาบาลเสนา"
HOSPITAL_NAME_EN="Sena Hospital"

