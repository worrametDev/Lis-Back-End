# ========================================================
# Healthdi Lab LIS — Backend Environment Variables Template
# ========================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Connection (PostgreSQL with Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthdi_lab?schema=public"

# Authentication & Security (JWT)
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# CORS Whitelist (Frontend Origin)
CORS_ORIGIN="http://localhost:3000"

# LIS Analyzer Gateway Settings
ANALYZER_TCP_PORT=5000
